+#if HAVE_TSEARCH
+/*
+ * Repeat call of a capability whose result is already memoised: look the
+ * format up by address, gather the numeric parameters, compare them with the
+ * memo and return its text.  Skips tparm_setup's clearing and copying of a
+ * TPARM_DATA, the stack setup and the copy into the output buffer (about 280
+ * us a call on a 68020 at 14 MHz, three calls per colour change).  The text
+ * is valid until the next call, like the output buffer.  Returns NULL when
+ * the general path must run.
+ */
+NCURSES_EXPORT_VAR(long) _nc_tparm_fast = 0;	/* calls answered here */
+
+static char *
+tparm_fast(const char *string, int use_TPARM_ARG, va_list ap)
+{
+    unsigned slot = (unsigned) TPARM_PTR_SLOT(string);
+    TPARM_DATA *fs = (TPARM_DATA *) tparm_ptr_cache[slot].entry;
+    TPARM_ARG param[NUM_PARM];
+    TPARM_MEMO *memo;
+    unsigned hash = 0;
+    int n;
+
+    if (tparm_ptr_cache[slot].key != string
+	|| fs->memo == NULL
+	|| fs->tparm_type != 0
+	|| strcmp(fs->format, string) != 0)
+	return NULL;
+    for (n = 0; n < fs->num_actual; ++n) {
+	param[n] = use_TPARM_ARG ? va_arg(ap, TPARM_ARG) : (TPARM_ARG) va_arg(ap, int);
+	hash = hash * 31u + (unsigned) param[n];
+    }
+    memo = fs->memo + (hash % TPARM_MEMO_SIZE);
+    if (!memo->used
+	|| memcmp(memo->param, param, sizeof(TPARM_ARG) * (size_t) fs->num_actual))
+	return NULL;
+    ++_nc_tparm_fast;
+    _nc_tparm_err = 0;
+    return memo->text;
+}
+
 #endif
 
