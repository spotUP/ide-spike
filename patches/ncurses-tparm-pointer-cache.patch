+NCURSES_EXPORT_VAR(long) _nc_tparm_walks = 0;	/* ... that walked the tree */
+/* capability strings sit a few bytes apart: mix the address before taking the slot */
+#define TPARM_PTR_SLOT(s) ((((unsigned long) (s) * 2654435761UL) >> 20) % TPARM_PTR_SIZE)
 
