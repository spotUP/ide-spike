 // via `newwin()`, it is safe to use `delwin()`.
 // It is important to note that even though `ScintillaCurses::wMain` is a Window, its `Destroy()`
 // function is never called, hence why `scintilla_delete()` is the complement to `scintilla_new()`.
+namespace {
+// Repaint area each curses window has accumulated since its last `NoutRefresh()`.
+struct Invalidation {
+	bool any = false; // something was invalidated
+	bool all = false; // `InvalidateAll()` was called
+	PRectangle rc;
+};
+std::map<WindowID, Invalidation> invalidations;
+} // namespace
+
+bool TakeInvalidatedRectangle(WindowID wid, PRectangle &rc) {
+	auto it = invalidations.find(wid);
+	if (it == invalidations.end() || !it->second.any) return false;
+	const Invalidation inv = it->second;
+	invalidations.erase(it);
+	if (inv.all) {
+		int maxy, maxx;
+		getmaxyx(_WINDOW(wid), maxy, maxx);
+		rc = PRectangle(0, 0, maxx, maxy);
+	} else
+		rc = inv.rc;
+	return true;
+}
+
 void Window::Destroy() noexcept {
